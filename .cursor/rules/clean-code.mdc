## Frontend Architecture — API Call Pattern

When frontend calls a backend API, **always** follow this 4-layer structure:

```
src/
  types/
    user.types.ts         ← Request/Response interfaces
  api/
    user.api.ts           ← Raw fetch/axios calls, no business logic
  context/
    UserContext.tsx        ← Global state if needed (auth, theme, etc.)
  hooks/
    useUser.ts            ← Business logic, loading/error states
  components/
    UserProfile.tsx        ← UI only, calls hooks
```

```typescript
// types/user.types.ts
export interface GetUserResponse {
  id: string;
  name: string;
  email: string;
}

// api/user.api.ts
export const userApi = {
  getById: (id: string): Promise<GetUserResponse> =>
    http.get(`/users/${id}`),
  update: (id: string, payload: UpdateUserPayload): Promise<GetUserResponse> =>
    http.patch(`/users/${id}`, payload),
};

// hooks/useUser.ts
export function useUser(id: string) {
  const [user, setUser] = useState<GetUserResponse | null>(null);
  const [isLoading, setIsLoading] = useState(false);
  const [error, setError] = useState<Error | null>(null);

  useEffect(() => {
    if (!id) return;
    setIsLoading(true);
    userApi.getById(id)
      .then(setUser)
      .catch(setError)
      .finally(() => setIsLoading(false));
  }, [id]);

  return { user, isLoading, error };
}
```

