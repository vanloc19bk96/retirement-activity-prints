## TypeScript — Always Typed

```typescript
// ❌ No implicit any
function process(data: any) {}

// ✅ Explicit types
function process(data: ProcessPayload): ProcessResult {}

// Use unknown over any for untrusted input
function parseApiResponse(raw: unknown): ApiResponse {
  return apiResponseSchema.parse(raw);
}
```

