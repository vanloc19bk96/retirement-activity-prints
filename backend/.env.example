# Supabase
# Internal URL for backend (Docker network), e.g. http://supabase-kong:8000
SUPABASE_URL=http://supabase-kong:8000
# Supabase REST/storage base URL as seen by the BROWSER. Must be Kong (or Supabase API), NOT this FastAPI service.
SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=retirement-activity-prints

# Shared buckets reused across projects (outlines + emoji SVGs)
OUTLINE_LIBRARY_STORAGE_BUCKET=outline-library
EMOJI_LIBRARY_STORAGE_BUCKET=emoji-library

# CORS
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Optional: allow any localhost/127.0.0.1 port (Vite picks 5173+)
# CORS_ALLOW_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1):\d+$

# Creator Hub sync (optional, enable after purchase/IPN)
# Production: https://hub.fastaifactory.com/api
# Local dev: http://host.docker.internal:8006/api
HUB_API_URL=http://host.docker.internal:8006/api
HUB_APP_CODE=retirement-activity-prints

# GrsAI image settings: Supabase retirement_activity_prints.ai_runtime_settings (id=default)
GEMINI_GENERATION_MAX_ATTEMPTS=3
GEMINI_GENERATION_BACKOFF_BASE_SECONDS=1

# Studio AI templates (Gemini) — server-side only; never expose to the browser
GEMINI_API_KEY=
STUDIO_GEMINI_MODEL=gemini-flash-lite-latest
STUDIO_GEMINI_TIMEOUT_SECONDS=90

# Redis (RQ job queue). Docker Compose overrides to redis://retirement-activity-prints-redis:6379/0
REDIS_URL=redis://localhost:6379/0
AI_IMAGE_JOB_TIMEOUT_SECONDS=900
AI_IMAGE_JOB_RESULT_TTL_SECONDS=3600
