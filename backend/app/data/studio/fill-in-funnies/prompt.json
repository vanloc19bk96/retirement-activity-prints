    "vehicle": { "label": "Vehicle", "hint": "like “tractor”", "classes": ["noun"] },
    "job": { "label": "Job title", "hint": "like “plumber”", "classes": ["noun"] },
    "hobby": { "label": "Hobby", "hint": "like “knitting”", "classes": ["noun", "verb_ing"] },
    "coworker_name": { "label": "Coworker’s name", "hint": "real or made up", "classes": ["name"] },
    "friend_name": { "label": "Friend’s name", "hint": "real or made up", "classes": ["name"] },
    "number": { "label": "Number", "hint": "like “47”", "classes": ["number"] },
