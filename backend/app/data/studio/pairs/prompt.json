{
  "_comment": "Paired-associates generation. collocations are pairs that feel 'natural' and so must never be used for the arbitrary type (§3.2); the first few also seed the WRONG examples inside the prompt.",
  "limits": {
    "minWordLen": 2,
    "maxWordLen": 12,
    "promptMinLetters": 3,
    "promptMaxLetters": 10,
    "promptExampleCount": 3,
    "rateLimitPerWindow": 60
  },
  "locale": {
    "nativeLocales": ["en"],
    "nativeLine": "- Write words in clear English.",
    "otherLine": "- Write words in language locale '{locale}'."
  },
  "collocations": [
    ["bread", "butter"],
    ["salt", "pepper"],
    ["needle", "thread"],
    ["knife", "fork"],
    ["cup", "saucer"],
    ["shoes", "socks"],
    ["pen", "paper"],
    ["lock", "key"],
    ["bow", "arrow"],
    ["brush", "paint"],
    ["soap", "water"],
    ["table", "chair"],
    ["cat", "mouse"],
    ["dog", "bone"],
    ["king", "queen"],
    ["day", "night"],
    ["sun", "sky"],
    ["fish", "pond"],
    ["bird", "nest"],
    ["bee", "honey"]
  ]
}
