{
  "_comment": "Retirement missing-vowels. candidateMultiplier=2 so we ask ~itemCount×2. lengthByDifficulty is letter count excluding spaces. Y is not a vowel.",
  "limits": {
    "candidateMultiplier": 2,
    "rateLimitPerWindow": 60,
    "maxOutputTokens": 4096,
    "minWordLetters": 4,
    "maxWordLetters": 14,
    "maxPhraseWords": 2,
    "minConsonants": 2
  },
  "lengthByDifficulty": {
    "relaxed": [4, 8],
    "classic": [5, 10],
    "challenge": [6, 14]
  },
  "locale": {
    "nativeLocales": ["en"],
    "nativeLine": "- Write in clear English.",
    "otherLine": "- Write in language locale '{locale}'."
  },
  "varietyAngles": [
    "everyday retirement lifestyle words",
    "weekend and leisure vocabulary",
    "home and garden words seniors know",
    "travel and outing vocabulary",
    "family and grandchildren words",
    "quiet hobbies and relaxation words",
    "nostalgic but upbeat memory words",
    "house and neighbourhood lifestyle words",
    "celebration and gathering words",
    "outdoor and walking vocabulary"
  ]
}
